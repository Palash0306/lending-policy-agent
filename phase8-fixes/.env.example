# Ollama server this project talks to. Point this at a local install or an
# internal company host running Ollama — never a public/hosted endpoint,
# since lending policy documents must stay on controlled infrastructure.
OLLAMA_HOST=http://localhost:11434

# Chat/completion model used for extraction (Phase 5+) and the Phase 1
# healthcheck. Any model pulled via `ollama pull <name>` works.
OLLAMA_MODEL=qwen2.5:7b

# Seconds to wait on a single generate/chat call. Extraction takes minutes on a laptop,
# so a low value (such as 120) causes timeouts.
OLLAMA_TIMEOUT=300

# Seconds to wait for a full `ollama pull` of a missing model.
OLLAMA_PULL_TIMEOUT=1800

# --- Embeddings + Chroma (Phase 3): fully local ---
# sentence-transformers model used to embed policy text and your search phrases.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
# Where the vector index is stored, and its collection name.
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=lending_policies

# --- Phase 8: chat server ---
# The server has no login, so it listens on this computer only by default.
API_HOST=127.0.0.1
API_PORT=8000
# Where uploaded policy files are kept, and the largest file accepted (MB).
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
# Conversation history is kept in memory: how many conversations, for how long, and how many turns each.
MAX_SESSIONS=200
SESSION_TTL_MINUTES=480
MAX_TURNS_PER_SESSION=30
