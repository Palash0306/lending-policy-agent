# Ollama server this project talks to. Point this at a local install or an
# internal company host running Ollama — never a public/hosted endpoint,
# since lending policy documents must stay on controlled infrastructure.
OLLAMA_HOST=http://localhost:11434

# Chat/completion model used for extraction (Phase 5+) and the Phase 1
# healthcheck. Any model pulled via `ollama pull <name>` works.
OLLAMA_MODEL=qwen2.5:7b

# Embedding model, used starting Phase 3 for Chroma indexing.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Seconds to wait on a single generate/chat call.
OLLAMA_TIMEOUT=120

# Seconds to wait for a full `ollama pull` of a missing model.
OLLAMA_PULL_TIMEOUT=1800
